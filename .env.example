APP_NAME=SpotOnApp
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000

APP_LOCALE=it
APP_FALLBACK_LOCALE=it
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=spotonapp_db
DB_USERNAME=spotonapp_user
DB_PASSWORD=

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
SPOTON_AUDIO_DISK=public
SPOTON_AUDIO_DIRECTORY=post-audios
SPOTON_SHARE_VIDEO_ENABLED=false
SPOTON_SHARE_VIDEO_DISK=local
SPOTON_SHARE_VIDEO_DIRECTORY=share-videos
SPOTON_SHARE_VIDEO_QUEUE=media
SPOTON_SHARE_VIDEO_DAILY_LIMIT=3
SPOTON_SHARE_VIDEO_BETA_EMAILS=
SPOTON_SHARE_VIDEO_TIMEOUT=60
SPOTON_SHARE_VIDEO_TEMPLATE_VERSION=v1
SPOTON_SHARE_VIDEO_FFMPEG_BINARY=ffmpeg
SPOTON_SHARE_VIDEO_FONT_PATH=/usr/share/fonts/truetype/dejavu/DejaVuSans.ttf
SPOTON_SHARE_VIDEO_FONT_BOLD_PATH=/usr/share/fonts/truetype/dejavu/DejaVuSans-Bold.ttf
SPOTON_SOCIAL_CARD_DISK=public
SPOTON_SOCIAL_CARD_DIRECTORY=share-cards
SPOTON_PUBLIC_CACHE_TTL_SECONDS=300
QUEUE_CONNECTION=redis

CACHE_STORE=redis
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

SPOTON_EMAIL_VERIFICATION_EXPIRE_MINUTES=60
SPOTON_PASSWORD_RESET_EXPIRE_MINUTES=30
SPOTON_PASSWORD_RESET_URL=http://127.0.0.1:8000/reset-password
SPOTON_EMAIL_VERIFIED_URL=http://127.0.0.1:8000/email-verified
SPOTON_PRIVACY_EMAIL=privacy@spotonapp.cloud
SPOTON_CHILD_SAFETY_EMAIL=privacy@spotonapp.cloud
SPOTON_LOCATION_RETENTION_HOURS=24
SPOTON_PRESENCE_RETENTION_DAYS=30
SPOTON_LOCATION_CREATE_DAILY_LIMIT=3
SPOTON_LOCATION_CREATE_MAX_DISTANCE_METERS=1000
SPOTON_LOCATION_DUPLICATE_RADIUS_METERS=150
SPOTON_LOCATION_POSITION_MAX_AGE_MINUTES=10
SPOTON_LOCATION_MAX_ACCURACY_METERS=100
SPOTON_LOCATION_DEFAULT_RADIUS_METERS=100
SPOTON_ANDROID_PACKAGE=it.spotonapp.app
SPOTON_ANDROID_SHA256_CERT_FINGERPRINTS=
SPOTON_APPLE_BUNDLE_IDENTIFIER=it.spotonapp.app
SPOTON_APPLE_TEAM_ID=

PUSH_DRIVER=log
EXPO_PUSH_ENDPOINT=https://exp.host/--/api/v2/push/send
EXPO_PUSH_RECEIPTS_ENDPOINT=https://exp.host/--/api/v2/push/getReceipts
EXPO_ACCESS_TOKEN=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
